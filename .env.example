# Copy to .env.local and fill in. Never commit .env.local.
ANTHROPIC_API_KEY=

# Model tiers (optional overrides)
ANTHROPIC_MODEL_FAST=claude-haiku-5-5
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_MODEL_DEEP=claude-opus-5-5

# LLM tuning (optional)
LLM_TIMEOUT_MS=30000
LLM_MAX_CONCURRENT=8
LLM_CACHE_TTL_MS=600000
